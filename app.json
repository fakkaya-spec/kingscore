{
  "expo": {
    "name": "King Skor",
    "slug": "king-skor",
    "owner": "fakkayas-team",
    "extra": {
      "eas": {
        "projectId": "a0553a0c-8320-4ff0-bdc3-57d2f7139bcf"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kingskor",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A2E1F",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2E1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kosko.kingskor"
    },
    "android": {
      "package": "com.kosko.kingskor",
      "adaptiveIcon": {
        "backgroundColor": "#0A2E1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Oyuncu kartlarına fotoğraf eklemek için galerinize erişim gerekir. Fotoğraflar yalnızca cihazınızda saklanır."
        }
      ]
    ]
  }
}
