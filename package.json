{
  "name": "kingscore",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-purchases": "^10.6.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-mmkv|react-native-purchases|zustand)"
    ]
  }
}
